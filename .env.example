# =============================================================================
# Velora API — 本地开发（复制为 .env.development，勿提交密钥）
# =============================================================================

PORT=4000
CLIENT_ORIGINS=http://localhost:3000

# 行情上游（MVP 代理 Binance，后期切换自有撮合行情）
BINANCE_REST_BASE_URL=https://data-api.binance.vision
BINANCE_WS_BASE_URL=wss://data-stream.binance.vision
MARKET_WS_PATH=/ws/market
EVENTS_WS_PATH=/ws/events
MARKET_RATE_LIMIT_PER_MIN=120
LIQUIDATION_WORKER_ENABLED=false

# JWT
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d
AUTH_SKIP_PATHS=/health,/api/v1/market,/api/v1/dashboard,/api/v1/events,/api/v1/billing/plans,/ws/market

# 数据库（本地可先关闭，有 MySQL 后改为 true 并填写连接信息）
DB_ENABLED=false
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=velora
DB_PASSWORD=
DB_NAME=velora_dev
DB_SSL=false

# 邮件（注册验证码，本地可关闭）
MAIL_ENABLED=false
RESEND_API_KEY=
MAIL_FROM=Velora <noreply@velora.com>

# 会员/支付（Velora CEX MVP 暂不使用）
BILLING_ENABLED=false

# KYC — 开发自动通过（Didit 启用后设为 false）
KYC_DEV_AUTO_APPROVE=true

# Didit KYC（https://business.didit.me 注册 → API Keys / Workflows）
# 启用后前端 /user/kyc 走 Didit（证件 + 活体 + 审核），不再走本地上传向导
DIDIT_ENABLED=false
DIDIT_API_KEY=
DIDIT_WORKFLOW_ID=
DIDIT_WEBHOOK_SECRET=
# 用户完成验证后跳回（本地示例；生产改为 https://app.velora.com/zh/user/kyc）
DIDIT_CALLBACK_URL=http://localhost:3000/zh/user/kyc
DIDIT_API_BASE_URL=https://verification.didit.me

# ── 测试环境（velora-api-test.aipassly.com + velora-test.aipassly.com）────
# CLIENT_ORIGINS=http://localhost:3000,https://velora-test.aipassly.com
# DIDIT_CALLBACK_URL=https://velora-test.aipassly.com/zh/user/kyc
# Didit Webhook: https://velora-api-test.aipassly.com/api/v1/kyc/didit/webhook
