# =============================================================================
# Velora 测试服 API — 服务器上的 .env.development
# 用法（在 Velora-api 目录）:
#   cp .env.server-test.example .env.development
#   填写下方密钥后: yarn deploy:test
#
# 域名:
#   API  https://velora-api-test.aipassly.com  → PM2 velora-api-test :4001
#   前端 https://velora-test.aipassly.com
# =============================================================================

PORT=4001

# CORS：必须包含测试前端域名
CLIENT_ORIGINS=http://localhost:3000,https://velora-test.aipassly.com

BINANCE_REST_BASE_URL=https://data-api.binance.vision
BINANCE_WS_BASE_URL=wss://data-stream.binance.vision
MARKET_WS_PATH=/ws/market
EVENTS_WS_PATH=/ws/events
MARKET_RATE_LIMIT_PER_MIN=120
LIQUIDATION_WORKER_ENABLED=false

JWT_SECRET=change-me-test-server-secret
JWT_EXPIRES_IN=7d
AUTH_SKIP_PATHS=/health,/api/v1/market,/api/v1/dashboard,/api/v1/events,/api/v1/billing/plans,/api/v1/kyc/config,/ws/market

# TiDB Cloud — velora 测试库
DB_ENABLED=true
DB_HOST=your-tidb-host
DB_PORT=4000
DB_USER=your-tidb-user
DB_PASSWORD=your-tidb-password
DB_NAME=velora
DB_SSL=true

# 邮件（注册验证码）
MAIL_ENABLED=true
RESEND_API_KEY=your-resend-api-key
MAIL_FROM=Velora <noreply@aipassly.com>

# 测试环境临时绕过：不发邮件，任意 6 位验证码可通过（仅 development）
AUTH_BYPASS_EMAIL_CODE=true

# KYC — 接 Didit 后关闭自动通过
KYC_DEV_AUTO_APPROVE=false

# Didit KYC — 对应 Didit 控制台 velora-test 应用
# DIDIT_API_KEY=从 Didit → API 密钥 → velora-test 复制
# DIDIT_WEBHOOK_SECRET=从 Didit → Webhook → velora-test 签名密钥复制
# DIDIT_WORKFLOW_ID=从 Didit → Workflows 复制（必填才能启用）
DIDIT_ENABLED=false
DIDIT_API_KEY=
DIDIT_WORKFLOW_ID=
DIDIT_WEBHOOK_SECRET=
DIDIT_CALLBACK_URL=https://velora-test.aipassly.com/zh/user/kyc
DIDIT_API_BASE_URL=https://verification.didit.me

BILLING_ENABLED=false
